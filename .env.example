# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Frontend origins allowed by CORS and Socket.IO (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ── Atlas v2 database (Prisma) ────────────────────────────────────────────
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=job_schedular_v2
DATABASE_CONNECTION_LIMIT=5

# ── Grove database (read-only source of artwork & proofing job cards) ─────
GROVE_DATABASE_HOST=
GROVE_DATABASE_PORT=3306
GROVE_DATABASE_USER=
GROVE_DATABASE_PASSWORD=
# grove_db_dev_backup while Grove is in development; grove_db once Grove is live
GROVE_DATABASE_NAME=grove_db_dev_backup
GROVE_SYNC_ENABLED=true
# How often new / changed / closed job cards are pulled from Grove (min 10000)
GROVE_SYNC_INTERVAL_MS=60000

# ── Auth ──────────────────────────────────────────────────────────────────
# At least 32 characters; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ── First admin user (used only by `npm run seed:admin`) ──────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
